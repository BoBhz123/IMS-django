# Build-context filter for the ROOT context (the backend image).
#
# Everything listed here is excluded before the Docker daemon ever sees it, which does three
# jobs: it keeps the image small, it keeps the build fast (the context is tarred and shipped to
# the daemon on every build), and — most importantly — it keeps secrets and host-specific
# artefacts out of a layer, where they would be permanently readable by anyone who pulls the
# image, even if a later instruction deleted them.
#
# This file has NO effect on Heroku. Heroku's equivalent is .slugignore, which is not present
# and is not being added.

# --- Version control ---------------------------------------------------------------------
# The full history, including any secret ever committed and later removed. Large and useless
# inside a container.
.git
.gitignore

# --- Secrets -------------------------------------------------------------------------------
# .env holds the Brevo SMTP password, PAYMENT_ENCRYPTION_KEY and the Paddle credentials. It
# must never be baked into an image layer.
#
# It IS still available to the running container: docker-compose.yml injects it at runtime via
# `env_file`, which passes the values into the process environment without writing them to disk
# in the image. Runtime injection and build-time copying are different things, and only the
# second one is a leak.
.env
.env.*
frontend/.env
frontend/.env.*

# --- Python ---------------------------------------------------------------------------------
# Compiled for the host interpreter and possibly a different Python patch level; a stale .pyc
# shadowing a source file is a genuinely confusing bug class.
__pycache__/
*.py[cod]
*$py.class

# The host virtualenv (pipenv puts this project's in ~/.local/share/virtualenvs, but a
# .venv/ can appear with PIPENV_VENV_IN_PROJECT). It contains binaries linked against the
# host's libc and would be useless — and huge — inside the image.
.venv/
venv/
env/

# --- Node ------------------------------------------------------------------------------------
# node_modules holds prebuilt NATIVE binaries (rollup, @tailwindcss/oxide, lightningcss,
# oxlint). The host's are glibc/x86_64 builds; the frontend image is musl. Copying them in
# would produce "invalid ELF header" at runtime. The frontend image runs its own `npm ci`
# inside the container, which resolves the correct musl variants.
node_modules/
frontend/node_modules/

# The compiled SPA. Regenerated by `npm run build`; under compose the bind mount supplies the
# host's copy anyway. Excluding it keeps a stale bundle from being frozen into an image layer.
frontend/dist/

# --- Django-generated -------------------------------------------------------------------------
# collectstatic output — regenerated, and already gitignored.
staticfiles/

# Developer-uploaded product images. Host state, not application code; the bind mount provides
# them in dev and production media lives in Cloudflare R2 (settings.STORAGES / ims.storage).
media/

# The legacy local SQLite database. This project runs on Postgres (settings.DATABASES); a
# committed .sqlite3 riding along in the image is pure confusion.
db.sqlite3
*.sqlite3

# --- Tooling / editor / OS --------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp

.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# --- Repo-local agent + docs state ------------------------------------------------------------
# Large, and irrelevant to running the application.
.claude/
.superpowers/
docs/

# Untracked leftovers from the deleted scratch app (see CLAUDE.md — playground/ was removed on
# 2026-08-10 because its unscoped view was one urls.py line away from a cross-tenant leak).
# It is not in INSTALLED_APPS; do not let it back into an image.
playground/

# Docker's own files — nothing inside the image needs to read them.
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
