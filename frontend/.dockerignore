# Build-context filter for the ./frontend context (the frontend image).
#
# A .dockerignore applies only to the context it sits at the root of. The compose file builds
# the frontend with `context: ./frontend`, so the repository-root .dockerignore is NOT consulted
# for that build — hence this second file. Without it, the host's glibc node_modules would be
# copied into a musl image.

# Host-built native binaries (rollup, @tailwindcss/oxide, lightningcss, oxlint) — wrong libc for
# the alpine base. The image runs its own `npm ci`.
node_modules

# Build output; regenerated by `npm run build`, and gitignored.
dist
dist-ssr

# Vite env files. This one currently holds only comments, but VITE_* values are inlined into the
# JS bundle at build time, so treating it as a secret-bearing file is the safe default.
.env
.env.*
*.local

# Logs, editor and OS noise.
*.log
npm-debug.log*
.vscode
.idea
.DS_Store

# Docker's own files.
Dockerfile
.dockerignore
